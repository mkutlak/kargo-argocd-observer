# Patterns to ignore when building packages.
.DS_Store
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
*.swp
*.bak
*.tmp
*.orig
*~
.project
.idea/
*.tmproj
.vscode/

# Packaged charts
*.tgz
# Local value overrides and credentials: `helm package` ships every file in
# this directory to a public registry unless it is listed here.
*.local.yaml
*.local.yml
.env
.env.*
*.pem
*.key
